# Existing TrueNAS dataset for the configuration, device keys, and index.
# Replace <pool> with the name of your storage pool.
SYNCTHING_STATE_DIR=/mnt/<pool>/appdata/syncthing

# Existing NAS directory that Syncthing can read and write.
SYNCTHING_DATA_DIR=/path/to/nas/share

# UID and GID with write access to both directories.
SYNCTHING_PUID=1000
SYNCTHING_PGID=1000

# Set to the NAS LAN IP for direct browser access from the LAN.
SYNCTHING_GUI_BIND=127.0.0.1
